generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

enum AddressType {
  SHIPPING
  BILLING
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  MERCADO_PAGO
  PAYPAL
  BANK_TRANSFER
  CASH_ON_DELIVERY
  OTHER
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

// ------------------------------------------------------
// USER & PROFILE (Vinculado 1:1 con Supabase Auth)
// ------------------------------------------------------

model Profile {
  id        String  @id @db.Uuid // Mapeado directamente a auth.users.id de Supabase
  email     String  @unique
  firstName String? @map("first_name")
  lastName  String? @map("last_name")
  phone     String?
  avatarUrl String? @map("avatar_url")
  role      Role    @default(CUSTOMER)

  addresses     Address[]
  orders        Order[]
  cart          Cart?
  wishlistItems WishlistItem[]
  reviews       Review[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model Address {
  id             String      @id @default(uuid()) @db.Uuid
  profileId      String      @map("profile_id") @db.Uuid
  type           AddressType @default(SHIPPING)
  recipientName  String      @map("recipient_name")
  phone          String
  streetAddress  String      @map("street_address")
  apartmentSuite String?     @map("apartment_suite")
  city           String
  stateProvince  String      @map("state_province")
  postalCode     String      @map("postal_code")
  country        String      @default("CO") // Código de país ISO (CO, MX, US, etc.)
  isDefault      Boolean     @default(false) @map("is_default")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([profileId])
  @@map("addresses")
}

// ------------------------------------------------------
// CATEGORÍAS & COLECCIONES
// ------------------------------------------------------

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  slug        String  @unique
  description String?
  imageUrl    String? @map("image_url")
  orderIndex  Int     @default(0) @map("order_index")
  isActive    Boolean @default(true) @map("is_active")

  // Jerarquía recursiva (Padre / Hijas) para subcategorías (ej. Hogar -> Muebles -> Salas)
  parentId String?    @map("parent_id") @db.Uuid
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  products ProductCategory[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId])
  @@map("categories")
}

model Collection {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  slug        String  @unique
  description String?
  imageUrl    String? @map("image_url")
  isActive    Boolean @default(true) @map("is_active")

  products CollectionProduct[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("collections")
}

// ------------------------------------------------------
// PRODUCTOS, VARIANTES & MULTIMEDIA (Ropa y Muebles/Hogar)
// ------------------------------------------------------

model Product {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  slug             String   @unique
  shortDescription String?  @map("short_description")
  description      String   @db.Text
  basePrice        Decimal  @map("base_price") @db.Decimal(12, 2)
  compareAtPrice   Decimal? @map("compare_at_price") @db.Decimal(12, 2)
  isPublished      Boolean  @default(false) @map("is_published")
  isFeatured       Boolean  @default(false) @map("is_featured")

  // Dimensiones y peso base (clave para muebles y cálculo de envíos)
  weight Decimal? @db.Decimal(8, 2) // en Kg
  width  Decimal? @db.Decimal(8, 2) // en cm
  height Decimal? @db.Decimal(8, 2) // en cm
  depth  Decimal? @db.Decimal(8, 2) // en cm

  categories    ProductCategory[]
  collections   CollectionProduct[]
  variants      ProductVariant[]
  images        ProductImage[]
  reviews       Review[]
  wishlistItems WishlistItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@index([isPublished, isFeatured])
  @@map("products")
}

model ProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model CollectionProduct {
  productId    String @map("product_id") @db.Uuid
  collectionId String @map("collection_id") @db.Uuid

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@map("collection_products")
}

model ProductVariant {
  id             String   @id @default(uuid()) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  sku            String   @unique
  name           String // Ej: "Negro / M" o "Roble / 140x70"
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(12, 2)
  stock          Int      @default(0)

  // Atributos específicos para ropa
  size     String? // Ej: "S", "M", "L", "XL" o "Individual", "King"
  color    String? // Ej: "Azul Marino", "Madera Nogal"
  colorHex String? @map("color_hex") // Ej: "#1E3A8A"
  material String? // Ej: "100% Algodón Pima", "Madera Maciza de Teca"

  // Dimensiones específicas de la variante (para muebles)
  weight Decimal? @db.Decimal(8, 2) // en Kg
  width  Decimal? @db.Decimal(8, 2) // en cm
  height Decimal? @db.Decimal(8, 2) // en cm
  depth  Decimal? @db.Decimal(8, 2) // en cm

  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model ProductImage {
  id         String  @id @default(uuid()) @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  variantId  String? @map("variant_id") @db.Uuid // Opcional: para vincular foto a variante de color
  url        String  @db.Text
  altText    String? @map("alt_text")
  orderIndex Int     @default(0) @map("order_index")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([variantId])
  @@map("product_images")
}

// ------------------------------------------------------
// CARRITO & LISTA DE DESEOS (WISHLIST)
// ------------------------------------------------------

model Cart {
  id        String  @id @default(uuid()) @db.Uuid
  profileId String? @unique @map("profile_id") @db.Uuid // Para usuarios autenticados
  sessionId String? @unique @map("session_id") // Para carritos de invitados no autenticados

  profile Profile?   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  items   CartItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id        String @id @default(uuid()) @db.Uuid
  cartId    String @map("cart_id") @db.Uuid
  variantId String @map("variant_id") @db.Uuid
  quantity  Int    @default(1)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model WishlistItem {
  id        String @id @default(uuid()) @db.Uuid
  profileId String @map("profile_id") @db.Uuid
  productId String @map("product_id") @db.Uuid

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([profileId, productId])
  @@map("wishlist_items")
}

// ------------------------------------------------------
// CUPONES & PROMOCIONES
// ------------------------------------------------------

model Coupon {
  id                String       @id @default(uuid()) @db.Uuid
  code              String       @unique // Ej: "VERANO20", "BIENVENIDO10"
  description       String?
  discountType      DiscountType @map("discount_type")
  discountValue     Decimal      @map("discount_value") @db.Decimal(10, 2)
  minOrderAmount    Decimal?     @map("min_order_amount") @db.Decimal(12, 2)
  maxDiscountAmount Decimal?     @map("max_discount_amount") @db.Decimal(12, 2)
  usageLimit        Int?         @map("usage_limit")
  usageCount        Int          @default(0) @map("usage_count")
  startDate         DateTime?    @map("start_date")
  endDate           DateTime?    @map("end_date")
  isActive          Boolean      @default(true) @map("is_active")

  orders OrderCoupon[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([code])
  @@map("coupons")
}

// ------------------------------------------------------
// PEDIDOS (ORDERS) & PAGOS
// ------------------------------------------------------

model Order {
  id          String  @id @default(uuid()) @db.Uuid
  orderNumber String  @unique @map("order_number") // Ej: "ORD-2026-0001"
  profileId   String? @map("profile_id") @db.Uuid

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  currency      String        @default("COP") // COP, MXN, USD, etc.

  // Montos del pedido
  subtotal       Decimal @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  shippingCost   Decimal @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount    Decimal @map("total_amount") @db.Decimal(12, 2)

  // Snapshots inmutables de las direcciones al momento de la compra
  shippingAddress Json  @map("shipping_address")
  billingAddress  Json? @map("billing_address")

  // Logística y seguimiento
  shippingMethod String? @map("shipping_method")
  trackingNumber String? @map("tracking_number")
  carrier        String?
  customerNotes  String? @map("customer_notes") @db.Text
  adminNotes     String? @map("admin_notes") @db.Text

  profile  Profile?      @relation(fields: [profileId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  payments Payment[]
  coupons  OrderCoupon[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([profileId])
  @@index([orderNumber])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid

  // Snapshots inmutables del producto y variante comprados
  productName String  @map("product_name")
  variantName String  @map("variant_name")
  sku         String
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  totalPrice  Decimal @map("total_price") @db.Decimal(12, 2)
  imageUrl    String? @map("image_url") @db.Text

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("order_items")
}

model OrderCoupon {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  couponId       String  @map("coupon_id") @db.Uuid
  code           String
  discountAmount Decimal @map("discount_amount") @db.Decimal(12, 2)

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)

  appliedAt DateTime @default(now()) @map("applied_at")

  @@unique([orderId, couponId])
  @@map("order_coupons")
}

model Payment {
  id            String          @id @default(uuid()) @db.Uuid
  orderId       String          @map("order_id") @db.Uuid
  provider      PaymentProvider
  transactionId String?         @unique @map("transaction_id")
  amount        Decimal         @db.Decimal(12, 2)
  currency      String          @default("COP")
  status        PaymentStatus   @default(PENDING)
  payload       Json? // Respuesta completa del webhook / SDK de la pasarela

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([transactionId])
  @@map("payments")
}

// ------------------------------------------------------
// RESEÑAS & CALIFICACIONES (REVIEWS)
// ------------------------------------------------------

model Review {
  id                 String  @id @default(uuid()) @db.Uuid
  productId          String  @map("product_id") @db.Uuid
  profileId          String  @map("profile_id") @db.Uuid
  rating             Int // Escala 1 a 5
  title              String?
  comment            String? @db.Text
  isVerifiedPurchase Boolean @default(false) @map("is_verified_purchase")
  isApproved         Boolean @default(true) @map("is_approved")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, profileId]) // Un usuario puede dejar 1 reseña por producto
  @@index([productId])
  @@index([profileId])
  @@map("reviews")
}
